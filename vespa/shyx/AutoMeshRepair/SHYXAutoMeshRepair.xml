<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="SHYXAutoMeshRepair"
                 class="vtkSHYXAutoMeshRepair"
                 label="SHYX Auto Mesh Repair">
      <Documentation short_help="SHYX Auto Mesh Repair: cluster self-intersections, dilate, local Alpha Wrap + smooth (Mesh Checker follow-up).">
        Further step after SHYX Mesh Checker for self-intersecting faces. Detects CGAL PMP
        self-intersections, groups each connected location into its own cell selection, expands
        by Dilate Layers, then runs the same local pipeline as SHYX Selection: Fill, Alpha Wrap,
        Union (hole-fill both sides, Alpha Wrap the patch, CGAL boolean union, optional bridge
        remesh + smooth/fair). One cluster is repaired per pass, then intersections are
        re-detected, up to Max Passes. Port 0 is the repaired mesh. Port 1 is first-pass
        intersecting triangles with SHYX_ClusterId. Requires CGAL 5.5+ (Alpha Wrapping).
      </Documentation>

      <OutputPort name="Repaired mesh" index="0" id="port0" />
      <OutputPort name="Intersection clusters" index="1" id="port1" />

      <InputProperty name="Input" command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="sources"/>
          <Group name="filters"/>
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkPolyData"/>
        </DataTypeDomain>
      </InputProperty>

      <IntVectorProperty name="DilateLayers"
                         label="Dilate layers (per cluster)"
                         command="SetDilateLayers"
                         number_of_elements="1"
                         default_values="3"
                         animateable="0">
        <IntRangeDomain name="range" min="0" max="64"/>
        <Documentation>
          Face-ring expansion of each intersecting-face cluster before local Alpha Wrap.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty name="MaxPasses"
                         label="Max repair passes"
                         command="SetMaxPasses"
                         number_of_elements="1"
                         default_values="32"
                         animateable="0">
        <IntRangeDomain name="range" min="1" max="256"/>
        <Documentation>
          One intersecting cluster is repaired per pass, then self-intersections are detected
          again. Stops early when none remain or a pass cannot repair any cluster.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty name="AttemptSoupRepair"
                         label="Soup repair first (orient + repair_polygon_soup)"
                         command="SetAttemptSoupRepair"
                         number_of_elements="1"
                         default_values="1"
                         animateable="0">
        <BooleanDomain name="bool"/>
        <Documentation>
          Same combinatorial soup repair as SHYX Mesh Checker before intersection detection.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty command="SetFairingContinuity"
                         name="FairingContinuity"
                         label="Fairing (hole fill)"
                         number_of_elements="1"
                         default_values="1"
                         animateable="0">
        <IntRangeDomain name="range" min="0" max="2"/>
        <Documentation>
          Continuity for CGAL hole fill on both sub-meshes (0 / 1 / 2), same as SHYX Hole Fill.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty command="SetSkipAlphaWrapping"
                         name="SkipAlphaWrapping"
                         label="Skip Alpha wrap (selected only)"
                         number_of_elements="1"
                         default_values="0"
                         panel_visibility="advanced"
                         animateable="0">
        <BooleanDomain name="bool"/>
        <Documentation>
          If on, each cluster is only hole-filled (no Alpha Wrapping).
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty command="SetAbsoluteThresholds"
                         name="AbsoluteThresholds"
                         label="Alpha wrap: absolute Alpha/Offset"
                         number_of_elements="1"
                         default_values="0"
                         panel_visibility="advanced"
                         animateable="0">
        <BooleanDomain name="bool"/>
        <Documentation>
          If off, Alpha and Offset are percentages of the mesh length (see VESPA Alpha Wrapping).
        </Documentation>
      </IntVectorProperty>

      <DoubleVectorProperty command="SetAlpha"
                            name="Alpha"
                            label="Alpha"
                            number_of_elements="1"
                            default_values="4.0"
                            panel_visibility="advanced"
                            animateable="1">
        <Documentation>Alpha wrap parameter (maximum circumradius of faces in the result).</Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty command="SetOffset"
                            name="Offset"
                            label="Offset"
                            number_of_elements="1"
                            default_values="0.05"
                            panel_visibility="advanced"
                            animateable="1">
        <Documentation>Alpha wrap offset (dilatation / shrink factor depending on context).</Documentation>
      </DoubleVectorProperty>

      <IntVectorProperty command="SetThrowOnSelfIntersection"
                         name="ThrowOnSelfIntersection"
                         label="Boolean: throw on self-intersection"
                         number_of_elements="1"
                         default_values="0"
                         panel_visibility="advanced"
                         animateable="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <IntVectorProperty command="SetOrientToBoundVolumeWhenNeeded"
                         name="OrientToBoundVolumeWhenNeeded"
                         label="Boolean: orient if volume unclear"
                         number_of_elements="1"
                         default_values="1"
                         panel_visibility="advanced"
                         animateable="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <IntVectorProperty name="UseUpdateAttributes"
                         command="SetUpdateAttributes"
                         label="Interpolate attributes (from full input)"
                         number_of_elements="1"
                         default_values="1"
                         panel_visibility="advanced"
                         animateable="0">
        <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <IntVectorProperty command="SetEnableBridgeCleanup"
                         name="EnableBridgeCleanup"
                         label="Bridge cleanup after union"
                         number_of_elements="1"
                         default_values="1"
                         animateable="0">
        <BooleanDomain name="bool"/>
        <Documentation>
          After each local CGAL union, remesh + smooth/fair the Alpha-Wrap / original bridge,
          same as SHYX Selection: Fill, Alpha Wrap, Union.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty command="SetBridgeDilateFromSeam"
                         name="BridgeDilateFromSeam"
                         label="Bridge: dilate from union seam"
                         number_of_elements="1"
                         default_values="0"
                         animateable="0">
        <BooleanDomain name="bool"/>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <IntVectorProperty command="SetBridgeDilateLayers"
                         name="BridgeDilateLayers"
                         label="Bridge: dilate layers"
                         number_of_elements="1"
                         default_values="3"
                         animateable="0">
        <IntRangeDomain name="range" min="0" max="64"/>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <DoubleVectorProperty command="SetBridgeTargetEdgeLength"
                            name="BridgeTargetEdgeLength"
                            label="Bridge: remesh target edge length"
                            number_of_elements="1"
                            default_values="-1"
                            panel_visibility="advanced"
                            animateable="0">
        <Documentation>
          Target edge length for local isotropic remesh. &lt;= 0 uses the mean edge length of the
          dilated cleanup patch.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </DoubleVectorProperty>

      <IntVectorProperty command="SetBridgeRemeshIterations"
                         name="BridgeRemeshIterations"
                         label="Bridge: remesh iterations"
                         number_of_elements="1"
                         default_values="3"
                         panel_visibility="advanced"
                         animateable="0">
        <IntRangeDomain name="range" min="1" max="50"/>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <IntVectorProperty command="SetBridgeRemeshRelaxationSteps"
                         name="BridgeRemeshRelaxationSteps"
                         label="Bridge: remesh relaxation steps"
                         number_of_elements="1"
                         default_values="3"
                         panel_visibility="advanced"
                         animateable="0">
        <IntRangeDomain name="range" min="0" max="50"/>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <IntVectorProperty command="SetBridgeSmoothMethod"
                         name="BridgeSmoothMethod"
                         label="Bridge: post-remesh method"
                         number_of_elements="1"
                         default_values="2"
                         panel_visibility="advanced"
                         animateable="0">
        <EnumerationDomain name="enum">
          <Entry text="None (remesh only)" value="0"/>
          <Entry text="Shape MCF (smooth_shape)" value="1"/>
          <Entry text="Fair" value="2"/>
        </EnumerationDomain>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <IntVectorProperty command="SetBridgeSmoothIterations"
                         name="BridgeSmoothIterations"
                         label="Bridge: shape smooth iterations"
                         number_of_elements="1"
                         default_values="8"
                         panel_visibility="advanced"
                         animateable="0">
        <IntRangeDomain name="range" min="0" max="50"/>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="BridgeSmoothMethod"
                                   value="1"/>
        </Hints>
      </IntVectorProperty>

      <DoubleVectorProperty command="SetBridgeSmoothTimeStep"
                            name="BridgeSmoothTimeStep"
                            label="Bridge: shape smooth time step"
                            number_of_elements="1"
                            default_values="0.0025"
                            panel_visibility="advanced"
                            animateable="0">
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="BridgeSmoothMethod"
                                   value="1"/>
        </Hints>
      </DoubleVectorProperty>

      <IntVectorProperty command="SetBridgeFairContinuity"
                         name="BridgeFairContinuity"
                         label="Bridge: fair continuity"
                         number_of_elements="1"
                         default_values="1"
                         panel_visibility="advanced"
                         animateable="0">
        <EnumerationDomain name="enum">
          <Entry text="C0" value="0"/>
          <Entry text="C1" value="1"/>
          <Entry text="C2" value="2"/>
        </EnumerationDomain>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="enabled_state"
                                   property="EnableBridgeCleanup"
                                   value="1"/>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="BridgeSmoothMethod"
                                   value="2"/>
        </Hints>
      </IntVectorProperty>

      <IntVectorProperty name="LogSteps"
                         label="Log steps (Output Messages)"
                         command="SetLogSteps"
                         number_of_elements="1"
                         default_values="1"
                         panel_visibility="advanced">
        <BooleanDomain name="bool"/>
        <Documentation>
          When on, prints per-pass diagnostics to the ParaView Output Messages window.
        </Documentation>
      </IntVectorProperty>

      <PropertyGroup label="Intersection clusters">
        <Property name="DilateLayers"/>
        <Property name="MaxPasses"/>
        <Property name="AttemptSoupRepair"/>
      </PropertyGroup>

      <PropertyGroup label="Bridge cleanup (after each local union)">
        <Property name="EnableBridgeCleanup"/>
        <Property name="BridgeDilateFromSeam"/>
        <Property name="BridgeDilateLayers"/>
        <Property name="BridgeTargetEdgeLength"/>
        <Property name="BridgeRemeshIterations"/>
        <Property name="BridgeRemeshRelaxationSteps"/>
        <Property name="BridgeSmoothMethod"/>
        <Property name="BridgeSmoothIterations"/>
        <Property name="BridgeSmoothTimeStep"/>
        <Property name="BridgeFairContinuity"/>
      </PropertyGroup>

      <Hints>
        <ShowInMenu category="SHYX" icon=":/VESPA/SHYX_Auto_Mesh_Repair.png"/>
      </Hints>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
