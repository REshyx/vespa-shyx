<ServerManagerConfiguration>
  <ProxyGroup name="representations">
    <RepresentationProxy name="HologramRepresentation"
                         class="vtkHologramRepresentation"
                         processes="client|dataserver|renderserver"
                         base_proxygroup="representations"
                         base_proxyname="SurfaceRepresentation">
      <Documentation>
        Triangle-edge hologram. Surface meshes are drawn as they are. Volume cells
        (tetrahedra, hexahedra, voxels, wedges, pyramids, and 3D image or structured
        grids) are split into every face, including interior faces. Quads stay quads
        so the diagonal is not a wire. Lattice keeps the wireframe and lets the flow
        pattern reveal the faces. Ghost hides faces except where the view
        grazes them (fresnel) or the scan passes. Fresnel Uniform skips the normal,
        so the same pattern brightens every face together. Solid Color tints both. Line Width
        is the wire thickness. Not a lattice in empty space: the lines are the mesh edges.
      </Documentation>

      <IntVectorProperty name="Animate"
                         command="SetAnimate"
                         default_values="1"
                         number_of_elements="1">
        <BooleanDomain name="bool" />
        <Documentation>Keep redrawing so the scan moves. Off leaves the band where it is.</Documentation>
      </IntVectorProperty>

      <IntVectorProperty name="Style"
                         command="SetStyle"
                         default_values="1"
                         number_of_elements="1">
        <EnumerationDomain name="enum">
          <Entry text="Lattice" value="0" />
          <Entry text="Ghost" value="1" />
        </EnumerationDomain>
        <Documentation>
          Lattice: wires stay on, faces show mainly inside the scan.
          Ghost: wires and faces appear where fresnel allows, and inside the scan.
          Fresnel Uniform ignores the normal, so Ghost brightens the whole surface together.
        </Documentation>
      </IntVectorProperty>

      <IntVectorProperty name="Flow"
                         command="SetFlow"
                         default_values="0"
                         number_of_elements="1">
        <EnumerationDomain name="enum">
          <Entry text="Foam" value="0" />
          <Entry text="Turbulence warp" value="1" />
          <Entry text="Maelstrom" value="2" />
          <Entry text="Scan" value="3" />
        </EnumerationDomain>
        <Documentation>
          Foam, Turbulence warp, and Maelstrom are noise glued to the mesh (Shadertoy 7sBcRG,
          NXS3DG, MflyRf). None of them pick an axis. Scan replaces the noise with a band
          that travels along Scan Axis.
        </Documentation>
      </IntVectorProperty>

      <DoubleVectorProperty name="WireOpacity"
                            command="SetWireOpacity"
                            default_values="0.01"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0" max="1" />
        <Documentation>Opacity of triangle edges. Display Opacity multiplies this.</Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="FaceOpacity"
                            command="SetFaceOpacity"
                            default_values="0.2"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0" max="1" />
        <Documentation>
          Strength of the triangle fill. Lattice uses a small resting value plus the scan.
          Ghost multiplies by the fresnel term.
        </Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="FresnelPower"
                            command="SetFresnelPower"
                            default_values="4"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.05" max="12" />
        <Documentation>
          Higher packs the reflection into a thinner grazing rim (or a tighter camera-facing spot).
          Hidden when Fresnel is Uniform.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="HG_FresnelMode"
                                   values="0 1"/>
        </Hints>
      </DoubleVectorProperty>

      <IntVectorProperty name="FresnelMode"
                         command="SetFresnelMode"
                         default_values="0"
                         number_of_elements="1">
        <EnumerationDomain name="enum">
          <Entry text="Rim (reflection)" value="0" />
          <Entry text="Facing camera" value="1" />
          <Entry text="Uniform" value="2" />
        </EnumerationDomain>
        <Documentation>
          Rim: triangles light up when the view skims them, like a reflection.
          Facing camera: triangles facing you are the ones that appear.
          Uniform: the noise or scan brightens every face the same amount. Normals are not used.
        </Documentation>
      </IntVectorProperty>

      <DoubleVectorProperty name="ScanStrength"
                            command="SetScanStrength"
                            default_values="2"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0" max="4" />
        <Documentation>How strongly the active flow lights faces and wires. 0 leaves only the resting fill.</Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="ScanSpeed"
                            command="SetScanSpeed"
                            default_values="2"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="-8" max="8" />
        <Documentation>
          How fast the active flow changes. Foam spins gradients, turbulence twists the warp,
          maelstrom changes the noise phase. In Scan, 1 crosses the bounds in about 5 seconds.
          Negative reverses it.
        </Documentation>
      </DoubleVectorProperty>

      <IntVectorProperty name="ScanAxis"
                         command="SetScanAxis"
                         default_values="0"
                         number_of_elements="1">
        <EnumerationDomain name="enum">
          <Entry text="X" value="0" />
          <Entry text="Y" value="1" />
          <Entry text="Z" value="2" />
          <Entry text="View depth" value="3" />
        </EnumerationDomain>
        <Documentation>
          Axis of the Scan flow. X, Y, and Z move through the dataset bounds and follow
          Display translation and rotation. View depth moves a plane perpendicular to the
          camera, from the near side of those bounds to the far side. Band Count is how
          many stripes fit across the axis.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="HG_Flow"
                                   value="3"/>
        </Hints>
      </IntVectorProperty>

      <DoubleVectorProperty name="ScanWidth"
                            command="SetScanWidth"
                            default_values="0.08"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.002" max="0.5" />
        <Documentation>
          Thickness of each stripe as a fraction of one period. 0.08 is a thin line; larger is a wider slab.
          Group Mesh uses the same thickness. Cells whose centers lie in the band light as a whole, like a crinkle slice.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="HG_Flow"
                                   value="3"/>
        </Hints>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="BandCount"
                            command="SetBandCount"
                            default_values="4"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.5" max="64" />
        <Documentation>
          How many features fit across the mesh bounds. Noise flows use this as density.
          Scan uses it as how many stripes lie along the axis, including Group Mesh.
          Foam's demo starts at 4;
          turbulence and maelstrom sit near 5 to 7.
        </Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="NoiseScale"
                            command="SetNoiseScale"
                            default_values="0.5"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.1" max="16" />
        <Documentation>
          Magnifies the noise. 1 keeps the size set by Band Count. Larger makes the
          bright patches bigger. Hidden in Scan.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="HG_Flow"
                                   value="3"
                                   inverse="1"/>
        </Hints>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="NoisePower"
                            command="SetNoisePower"
                            default_values="3"
                            number_of_elements="1">
        <DoubleRangeDomain name="range" min="0.2" max="16" />
        <Documentation>
          Contrast of the noise. 1 is linear. Higher keeps only the peaks, so a small
          part of the surface lights up and the rest stays dark. Hidden in Scan.
        </Documentation>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                   mode="visibility"
                                   property="HG_Flow"
                                   value="3"
                                   inverse="1"/>
        </Hints>
      </DoubleVectorProperty>

      <IntVectorProperty name="GroupMesh"
                         command="SetGroupMesh"
                         default_values="0"
                         number_of_elements="1">
        <BooleanDomain name="bool" />
        <Documentation>
          Group by the original volume cell. Every face of one cell shares that cell's centroid,
          so the cell lights as a whole and the next cell can still be dark. Off samples each
          fragment at its own position, and Scan cuts a slice through the faces. On, Scan keeps
          the same band speed, count, and width, but each volume cell is wholly inside or outside
          that band from its center, like a crinkle slice. Cells leave the band as it moves on.
          Noise uses one value per cell. A surface polygon uses its own centroid.
          Fresnel stays per face, unless Fresnel is Uniform, which ignores the normal.
        </Documentation>
      </IntVectorProperty>
    </RepresentationProxy>

    <Extension name="GeometryRepresentation">
      <RepresentationType subproxy="HologramRepresentation" text="Hologram" />
      <SubProxy>
        <Proxy name="HologramRepresentation"
               proxygroup="representations"
               proxyname="HologramRepresentation" />
        <ShareProperties subproxy="SurfaceRepresentation">
          <Exception name="Input" />
          <Exception name="Visibility" />
          <Exception name="Representation" />
        </ShareProperties>
        <ExposedProperties>
          <PropertyGroup label="Hologram">
            <Property name="Animate" exposed_name="HG_Animate" />
            <Property name="Style" exposed_name="HG_Style" />
            <Property name="Flow" exposed_name="HG_Flow" />
            <Property name="WireOpacity" exposed_name="HG_WireOpacity" />
            <Property name="FaceOpacity" exposed_name="HG_FaceOpacity" />
            <Property name="FresnelPower" exposed_name="HG_FresnelPower" />
            <Property name="FresnelMode" exposed_name="HG_FresnelMode" />
            <Property name="ScanStrength" exposed_name="HG_ScanStrength" />
            <Property name="ScanSpeed" exposed_name="HG_ScanSpeed" />
            <Property name="ScanAxis" exposed_name="HG_ScanAxis" />
            <Property name="ScanWidth" exposed_name="HG_ScanWidth" />
            <Property name="BandCount" exposed_name="HG_BandCount" />
            <Property name="NoiseScale" exposed_name="HG_NoiseScale" />
            <Property name="NoisePower" exposed_name="HG_NoisePower" />
            <Property name="GroupMesh" exposed_name="HG_GroupMesh" />
            <Hints>
              <PropertyWidgetDecorator type="GenericDecorator"
                                       mode="visibility"
                                       property="Representation"
                                       value="Hologram" />
            </Hints>
          </PropertyGroup>
        </ExposedProperties>
      </SubProxy>
    </Extension>

