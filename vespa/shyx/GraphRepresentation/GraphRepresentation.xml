          <PropertyGroup label="Face">
            <Property name="ShowFace" exposed_name="GR_ShowFace" />
            <Property name="FaceArray" exposed_name="GR_FaceArray" />
            <Property name="FaceColor" exposed_name="GR_FaceColor" />
            <Property name="FaceOpacity" exposed_name="GR_FaceOpacity" />
            <Hints>
              <PropertyWidgetDecorator type="GenericDecorator"
