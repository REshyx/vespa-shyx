          </PropertyGroup>
          <PropertyGroup label="Volume">
            <Property name="ShowVolume" exposed_name="GR_ShowVolume" />
            <Property name="VolumeArray" exposed_name="GR_VolumeArray" />
            <Property name="VolumeColor" exposed_name="GR_VolumeColor" />
            <Property name="VolumeOpacity" exposed_name="GR_VolumeOpacity" />
            <Hints>
              <PropertyWidgetDecorator type="GenericDecorator"
                                       mode="visibility"
                                       property="Representation"
                                       value="Graph" />
            </Hints>
          </PropertyGroup>
          <PropertyGroup label="Graph labels">
            <Property name="MaximumNumberOfLabels" exposed_name="GR_MaximumNumberOfLabels" />
            <Property name="LabelFormat" exposed_name="GR_LabelFormat" />
            <Property name="LabelFontSize" exposed_name="GR_LabelFontSize" />
            <Hints>
              <PropertyWidgetDecorator type="GenericDecorator"
                                       mode="visibility"
                                       property="Representation"
                                       value="Graph" />
            </Hints>
          </PropertyGroup>
        </ExposedProperties>
      </SubProxy>
    </Extension>

