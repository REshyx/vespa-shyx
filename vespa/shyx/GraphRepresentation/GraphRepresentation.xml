            <Property name="VertexOpacity" exposed_name="GR_VertexOpacity" />
            <Property name="VertexScale" exposed_name="GR_VertexScale" />
            <Hints>
              <PropertyWidgetDecorator type="GenericDecorator"
                                       mode="visibility"
                                       property="Representation"
                                       value="Graph" />
            </Hints>
          </PropertyGroup>
          <PropertyGroup label="Line">
