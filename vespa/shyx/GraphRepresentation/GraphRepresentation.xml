        </ShareProperties>
        <ExposedProperties>
          <PropertyGroup label="Vertex">
            <Property name="ShowVertex" exposed_name="GR_ShowVertex" />
            <Property name="AllPoint" exposed_name="GR_AllPoint" />
            <Property name="VertexArray" exposed_name="GR_VertexArray" />
